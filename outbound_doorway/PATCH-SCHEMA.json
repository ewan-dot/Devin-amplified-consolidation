{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutboundDoorwayPatch",
  "type": "object",
  "required": ["patch_id", "agent_id", "created_at", "target_repo", "base_ref", "operations"],
  "properties": {
    "patch_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "target_repo": { "type": "string" },
    "base_ref": { "type": "string" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path", "content_sha256", "content"],
        "properties": {
          "op": { "enum": ["write"] },
          "path": { "type": "string" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content": { "type": "string" }
        }
      }
    },
    "witness": {
      "type": "object",
      "properties": {
        "vellum_entry_id": { "type": "string" },
        "epistemic_tier": { "type": "string" }
      }
    }
  }
}
